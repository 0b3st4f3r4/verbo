#!/usr/bin/env bash
# Wrapper fino do pre-commit (framework) — a bateria inteira vive no
# .pre-commit-config.yaml (espelho do CI); este script só resolve o ambiente:
# o cache/store do framework fica no workspace porque o HOME pode ser
# read-only (mesma regra do CARGO_HOME no Makefile).
set -euo pipefail

RAIZ="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "pre-commit: fora de um repositório git" >&2
  exit 1
}
export PRE_COMMIT_HOME="${PRE_COMMIT_HOME:-$RAIZ/.pc-cache}"

PC="$RAIZ/.venv/bin/pre-commit"
if [ ! -x "$PC" ]; then
  PC="$(command -v pre-commit || true)"
fi
if [ -z "${PC:-}" ]; then
  echo "pre-commit ausente — instale com: pip install -r requirements-dev.txt (ou make setup)" >&2
  exit 1
fi

exec "$PC" "$@"
